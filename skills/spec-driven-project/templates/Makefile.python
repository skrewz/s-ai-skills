# Python — spec-driven project (uv-first)
# Makefile-driven: build/test/lint/clean are the standard targets. CI, if
# present, calls these same targets. Tool invocations go through `uv` (uv-first):
# `uv run <tool>` for project tools. Delete the `e2e` target if no e2e mechanism
# is called for; otherwise set it to your runner (e.g. `uv run pytest -m e2e`
# with pytest-playwright, or a dedicated e2e test module).
.PHONY: all build test lint clean e2e image image-run image-clean

all: build test

build:
	uv run python -m compileall -q .

test:
	uv run pytest

lint:
	uv run black --check .
	uv run ruff check .

clean:
	rm -rf .pytest_cache build dist .ruff_cache .venv

# e2e — delete if no e2e mechanism is called for.
e2e:
	uv run pytest -m e2e

# --- container (build the payload application image) ------------------------
# Delete these (and the Containerfile) if a container is not required.
IMAGE ?= app

image:
	podman build -t $(IMAGE) .

image-run:
	podman run --rm -it $(IMAGE)

image-clean:
	podman rmi -f $(IMAGE) || true
